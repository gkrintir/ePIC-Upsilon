+    CaloDirection At(std::size_t i) { return Direction(x[i], y[i], z[i]); }
+};
+
+class TrackProjectionReplay {
+public:
+    explicit TrackProjectionReplay(TTreeReader& r)
+        : reader_(r), begin_(r, "CalorimeterTrackProjections.points_begin"),
+          end_(r, "CalorimeterTrackProjections.points_end"),
+          tracks_(r, "_CalorimeterTrackProjections_track"),
+          system_(r, "_CalorimeterTrackProjections_points.system"),
+          surface_(r, "_CalorimeterTrackProjections_points.surface"),
+          points_(r, "_CalorimeterTrackProjections_points"),
+          barrel_(r, "EcalBarrelClusters"), backward_(r, "EcalEndcapNClusters"),
+          forward_(r, "EcalEndcapPClusters") {}
+
+    std::vector<RecoLink> CheckedLinks(const CollectionIDs& ids, const std::set<ObjectKey>& tracks,
+                                       const std::vector<RecoLink>& stored, std::size_t barrelSize,
+                                       std::size_t backwardSize, std::size_t forwardSize) {
+        if (begin_.GetSetupStatus() < 0 || end_.GetSetupStatus() < 0 ||
+            tracks_.GetSetupStatus() < 0 || system_.GetSetupStatus() < 0 || surface_.GetSetupStatus() < 0 ||
+            system_.GetSize() != surface_.GetSize() ||
+            begin_.GetSize() != end_.GetSize() || begin_.GetSize() != tracks_.GetSize())
+            throw std::runtime_error("EICrecon #3011 replay: unreadable or inconsistent track projections.");
+        points_.RequireSize(system_.GetSize());
+        std::vector<ProjectedSegment> segments;
+        segments.reserve(begin_.GetSize());
+        for (std::size_t s = 0; s < begin_.GetSize(); ++s) {
+            const auto track = Key(tracks_[s]);
+            if (!tracks.count(track) || begin_[s] > end_[s] || end_[s] > system_.GetSize())
+                throw std::runtime_error("EICrecon #3011 replay: invalid segment track or point range.");
+            segments.push_back({track, {}});
+            for (std::size_t p = begin_[s]; p < end_[s]; ++p) {
+                if (surface_[p] == 1)
+                    segments.back().points.push_back({system_[p], points_.At(p)});
+            }
+        }
+        std::vector<RecoLink> corrected;
+        const auto append = [&](const char* name, std::uint32_t system,
+                                PositionReader& reader, std::size_t count) {
+            const auto id = ids.at(name);
+            reader.RequireSize(count);
+            std::vector<CaloDirection> directions;
+            directions.reserve(count);
+            for (std::size_t i = 0; i < count; ++i) directions.push_back(reader.At(i));
+            const auto old = ReplayClusterMatches(segments, system, id, directions, false);
+            std::size_t i = 0;
+            const auto mismatch = [&] {
+                return std::runtime_error(std::string("EICrecon #3011 replay does not reproduce stored ") +
+                    name + " links at event " + std::to_string(reader_.GetCurrentEntry()) +
+                    ". Check the input campaign, geometry and matcher before proceeding.");
+            };
+            for (const auto& link : stored) {
+                if (link.cluster.collection != id) continue;
+                if (i == old.size() || !(link.track == old[i].track) || !(link.cluster == old[i].cluster))
+                    throw mismatch();
+                ++i;
+            }
+            if (i != old.size()) throw mismatch();
+            const auto fixed = ReplayClusterMatches(segments, system, id, directions, true);
+            corrected.insert(corrected.end(), fixed.begin(), fixed.end());
+        };
+        // These are detector-system numbers, distinct from per-file PODIO collection IDs.
+        append("EcalBarrelClusters",   101, barrel_,   barrelSize);
+        append("EcalEndcapNClusters",  103, backward_, backwardSize);
+        append("EcalEndcapPClusters",  102, forward_,  forwardSize);
+        return corrected;
+    }
+private:
+    TTreeReader& reader_;
+    TTreeReaderArray<unsigned int> begin_, end_;
+    TTreeReaderArray<podio::ObjectID> tracks_;
+    TTreeReaderArray<UInt_t> system_;
+    TTreeReaderArray<ULong_t> surface_; // On-disk type in both July pilot files.
+    PositionReader points_, barrel_, backward_, forward_;
+};
+#endif

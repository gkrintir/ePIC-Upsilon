+#ifdef UPSILON_REMATCH_3011
+// EICrecon v1.39.2 TrackClusterMatch, using the July 2026 detector geometry.
+// The old path is replayed as an event-level check on the geometry and ordering.
+struct CaloDirection { double eta, phi; };
+inline CaloDirection Direction(float x, float y, float z) {
+    // edm4hep v01-00 vector_utils.h on Vector3f: anglePolar/angleAzimuthal
+    // perform the coordinate operations on floats before angleToEta takes a double.
+    const double theta = std::atan2(std::hypot(x, y), z);
+    return {-std::log(std::tan(0.5 * theta)), std::atan2(y, x)};
+}
+struct SurfacePoint { std::uint32_t system; CaloDirection direction; };
+struct ProjectedSegment { ObjectKey track; std::vector<SurfacePoint> points; };
+
+inline std::vector<RecoLink> ReplayClusterMatches(
+    const std::vector<ProjectedSegment>& segments, std::uint32_t system,
+    std::uint32_t collection, const std::vector<CaloDirection>& clusters,
+    bool corrected) {
+    std::vector<bool> used(segments.size(), false);
+    std::vector<RecoLink> result;
+    const double twoPi = 2 * std::acos(-1.0);
+    for (std::size_t c = 0; c < clusters.size(); ++c) {
+        double closest = 0.5;
+        std::size_t best = segments.size();
+        for (std::size_t s = 0; s < segments.size(); ++s) {
+            if (used[s]) {
+                // The v1.39.2 manual index stalls at the first used segment:
+                // its continue also skips the increment on every later iteration.
+                if (!corrected) break;
+                continue;
+            }
+            for (const auto& point : segments[s].points) {
+                if (point.system != system) continue;
+                const auto& d = point.direction;
+                const double dphi = std::remainder(clusters[c].phi - d.phi, twoPi);
+                const double distance = std::hypot(clusters[c].eta - d.eta, dphi);
+                if (distance < closest) {
+                    closest = distance;
+                    best = s;
+                }
+            }
+        }
+        if (best != segments.size()) {
+            used[best] = true;
+            result.push_back({segments[best].track, {collection, static_cast<int>(c)}});
+        }
+    }
+    return result;
+}
+#endif
